---
// The journey map — a real MapLibre GL JS + OpenFreeMap vector map, recolored
// to the Detourist palette, with one scrapbook pin per entry geopoint and a
// dashed route line by date. Client-side island; the rest of the page is static.
//
//   variant="full"   -> interactive, fills the .jbig__field card (Journey page)
//   variant="teaser" -> static, compact (homepage teaser)
import type { Entry, TripColor } from '@/lib/types';

interface Props {
  entries: Entry[];
  liveSlug?: string;
  variant?: 'full' | 'teaser';
}

const { entries, liveSlug, variant = 'full' } = Astro.props;

const COLOR_HEX: Record<TripColor, string> = {
  coral: '#FF6A4D',
  teal: '#16B3A7',
  magenta: '#F0407F',
  gold: '#FFB22E',
};

const points = entries
  .filter((e) => e.location)
  .map((e) => ({
    slug: e.slug,
    name: e.location!.name,
    lat: e.location!.lat,
    lng: e.location!.lng,
    color: COLOR_HEX[e.tripColor],
    live: e.slug === liveSlug,
  }));

const data = JSON.stringify(points);
---
<div
  class:list={[
    'detourist-map',
    variant === 'teaser' ? 'detourist-map--teaser jmap-teaser' : 'detourist-map--full jbig__field',
  ]}
  data-variant={variant}
  data-points={data}
  role="img"
  aria-label="Map of the journey so far, with a pin for each place visited."
>
</div>

<style is:global>
  /* compact, non-interactive teaser container */
  .jmap-teaser {
    position: relative;
    height: 330px;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
  }
  .detourist-map .maplibregl-map {
    border-radius: inherit;
    font-family: var(--body);
  }

  /* scrapbook teardrop markers */
  .map-pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }
  .map-pin__dot {
    line-height: 0;
    filter: drop-shadow(0 4px 5px rgba(0, 0, 0, 0.35));
    transition: transform 0.12s ease;
  }
  .map-pin:hover .map-pin__dot {
    transform: scale(1.18) translateY(-2px);
  }
  .map-pin__lbl {
    margin-top: 4px;
    font-family: var(--stamp);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11.5px;
    background: #fff;
    color: var(--plum);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    box-shadow: 0 4px 8px -4px rgba(0, 0, 0, 0.4);
  }
  .map-pin.is-live .map-pin__dot {
    transform: scale(1.12);
  }
  .map-pin.is-live .map-pin__lbl {
    background: var(--coral);
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .map-pin.is-live .map-pin__lbl .live-dot {
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
  }
  /* the teaser is a glance, not a tool — only the live pin keeps its label */
  .detourist-map--teaser .map-pin:not(.is-live) .map-pin__lbl {
    display: none;
  }
</style>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const STYLE = 'https://tiles.openfreemap.org/styles/liberty';
  // palette recolor targets
  const PAPER = '#FFF7ED';
  const WATER = '#bfe7e2';
  const LAND = '#f4e7d2';
  const BUILDING = '#f0dcc2';

  type Pt = { slug: string; name: string; lat: number; lng: number; color: string; live: boolean };

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function pinSvg(color: string): string {
    return (
      `<svg width="24" height="30" viewBox="0 0 24 30" fill="${color}" xmlns="http://www.w3.org/2000/svg">` +
      `<path d="M12 0C5.4 0 0 5.2 0 11.7 0 20 12 30 12 30s12-10 12-18.3C24 5.2 18.6 0 12 0z"/>` +
      `<circle cx="12" cy="11.5" r="4.5" fill="#fff"/></svg>`
    );
  }

  function recolor(map: maplibregl.Map): void {
    let layers: maplibregl.LayerSpecification[] = [];
    try {
      layers = map.getStyle().layers ?? [];
    } catch {
      return;
    }
    for (const layer of layers) {
      const id = layer.id;
      try {
        if (layer.type === 'background') map.setPaintProperty(id, 'background-color', PAPER);
        else if (layer.type === 'fill' && /water|ocean|sea|bay/i.test(id)) map.setPaintProperty(id, 'fill-color', WATER);
        else if (layer.type === 'line' && /water|river|waterway/i.test(id)) map.setPaintProperty(id, 'line-color', WATER);
        else if (layer.type === 'fill' && /(park|wood|forest|grass|landcover|landuse|wetland|sand|golf)/i.test(id))
          map.setPaintProperty(id, 'fill-color', LAND);
        else if (layer.type === 'fill' && /building/i.test(id)) map.setPaintProperty(id, 'fill-color', BUILDING);
      } catch {
        /* layer doesn't support that paint prop — skip */
      }
    }
  }

  function setupMap(el: HTMLElement): void {
    let raw: Pt[] = [];
    try {
      raw = JSON.parse(el.dataset.points ?? '[]');
    } catch {
      return;
    }
    if (!raw.length) return;

    const teaser = el.dataset.variant === 'teaser';
    // Unwrap western-hemisphere longitudes (+360) so Malaysia -> Canada is one
    // continuous eastward arc across the Pacific, not the long way round.
    const pts = raw.map((p) => ({ ...p, ulng: p.lng < -30 ? p.lng + 360 : p.lng }));

    const map = new maplibregl.Map({
      container: el,
      style: STYLE,
      interactive: !teaser,
      attributionControl: { compact: true },
      dragRotate: false,
      pitchWithRotate: false,
    });
    if (!teaser) map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    map.on('load', () => {
      recolor(map);

      // dashed route line in date order
      if (pts.length >= 2) {
        map.addSource('route', {
          type: 'geojson',
          data: {
            type: 'Feature',
            properties: {},
            geometry: { type: 'LineString', coordinates: pts.map((p) => [p.ulng, p.lat]) },
          },
        });
        map.addLayer({
          id: 'route',
          type: 'line',
          source: 'route',
          layout: { 'line-cap': 'round', 'line-join': 'round' },
          paint: { 'line-color': '#F2562F', 'line-width': 3, 'line-dasharray': [1.5, 2], 'line-opacity': 0.85 },
        });
      }

      // markers
      for (const p of pts) {
        const wrap = document.createElement('a');
        wrap.className = 'map-pin' + (p.live ? ' is-live' : '');
        wrap.href = '/entries/' + p.slug;
        wrap.setAttribute('aria-label', p.name);
        wrap.innerHTML =
          '<span class="map-pin__dot">' +
          pinSvg(p.color) +
          '</span><span class="map-pin__lbl">' +
          (p.live ? '<span class="live-dot"></span>' : '') +
          esc(p.name) +
          '</span>';
        new maplibregl.Marker({ element: wrap, anchor: 'bottom' }).setLngLat([p.ulng, p.lat]).addTo(map);
      }

      // frame the journey
      const lngs = pts.map((p) => p.ulng);
      const lats = pts.map((p) => p.lat);
      const min: [number, number] = [Math.min(...lngs), Math.min(...lats)];
      const max: [number, number] = [Math.max(...lngs), Math.max(...lats)];
      if (min[0] === max[0] && min[1] === max[1]) {
        map.jumpTo({ center: [pts[0].ulng, pts[0].lat], zoom: teaser ? 3 : 4 });
      } else {
        map.fitBounds([min, max], {
          padding: teaser ? 46 : 64,
          maxZoom: teaser ? 3.2 : 5,
          duration: 0,
        });
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.detourist-map').forEach(setupMap);
</script>
