---
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages.css';
import Polaroid from '@/components/Polaroid.astro';
import Stamp from '@/components/Stamp.astro';
import { getCurrentTrip, getEntries, getSiteSettings } from '@/lib/content';

const current = await getCurrentTrip();
const entries = await getEntries();
const site = await getSiteSettings();
const liveEntry = current ? entries.find((e) => e.tripSlug === current.slug) : undefined;
const currentPlace = liveEntry?.location?.name ?? 'Banff, Alberta';
const region = current?.region ?? 'Canada';
---
<Layout title="About — Detourist" active="about" description="Hey, I'm Vito — the serial detour-taker behind Detourist.">
  <!-- ABOUT HERO -->
  <section class="about-hero bg-paper2">
    <div class="wrap about-hero__split">
      <div class="about-hero__copy">
        <span class="eyebrow">The human behind the pins</span>
        <h1 class="about__name">Hey, I'm <span class="accent">Vito</span></h1>
        <p class="about-hero__lead">A serial detour-taker currently writing my way around the world, one slightly-too-honest dispatch at a time.</p>
        <div class="hero__cta" style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href="/journey" class="btn btn--coral btn--lg">Read the stories</a>
          <a href="#say-hi" class="btn btn--ghost btn--lg">Say hi</a>
        </div>
      </div>
      <div class="about-portrait">
        <Polaroid
          wide
          tilt="r"
          tape="coral"
          tapeStyle="top:-14px;left:34%;transform:rotate(-5deg);"
          tint="gold"
          labelPin
          image={site.portrait?.asset}
          label="portrait photo · me, somewhere scenic"
          alt={site.portrait?.alt ?? 'A portrait of Vito, somewhere scenic'}
          caption="that's me ✦"
        />
        <Stamp big="EST." variant="teal" tilt="l">on the<br />road</Stamp>
      </div>
    </div>
  </section>

  <!-- BIO -->
  <section class="section bg-paper">
    <div class="wrap about-body">
      <p class="dropcap">I didn't set out to be a travel writer. I set out to take a two-week holiday, took a wrong turn at a night market in Penang, and somehow never fully came back. These days "home" is wherever my charger is plugged in, and the blog is how I keep my friends — and apparently a few kind strangers — in the loop.</p>
      <p>I'm not here to sell you a ten-step itinerary or the perfect packing list. I'm here for the in-between bits: the diner with the suspicious coffee, the bus driver who took the corners too fast, the sunrise I almost slept through. The plans rarely survive contact with reality, and honestly that's become my favourite part.</p>
      <p class="pull">If it's a little messy and mostly true, it'll probably end up here.</p>
      <p>Right now I'm deep in the Canadian Rockies, eating my body weight in baked goods and pretending I know how to read a trail map. You can follow the live trip on the <a href="/journey#map">journey map</a>, or start from the very beginning back in Malaysia.</p>

      <div class="about-cards">
        <div class="factcard">
          <h3>The quick facts</h3>
          <div class="facts">
            <div class="row"><span class="k">Currently</span><span class="v">{currentPlace} 🍁</span></div>
            <div class="row"><span class="k">Home base</span><span class="v">wherever the charger is</span></div>
            <div class="row"><span class="k">Trips logged</span><span class="v">Malaysia · Singapore · Canada</span></div>
            <div class="row"><span class="k">Camera</span><span class="v">whatever's in my pocket</span></div>
            <div class="row"><span class="k">Fuel</span><span class="v">coffee &amp; curiosity</span></div>
            <div class="row"><span class="k">Strong opinion</span><span class="v">window seat, always</span></div>
          </div>
        </div>
        <div class="nowcard">
          <span class="tape tape--coral"></span>
          <h3>Currently</h3>
          <div class="big">In {region}</div>
          <p>Chasing alpine sunrises, dodging elk, and writing this from a cabin with surprisingly good wifi.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COUNTRIES -->
  <section class="section bg-paper2">
    <div class="wrap">
      <div class="title-block">
        <span class="eyebrow">Stamps in the passport</span>
        <h2 class="script h-lg">Where I've wandered</h2>
      </div>
      <div class="stamps">
        <Stamp big="MY" variant="magenta" tilt="l">Malaysia<br />7 days</Stamp>
        <Stamp big="SG" variant="teal" tilt="r">Singapore<br />11 days</Stamp>
        <Stamp big="CA" variant="coral" tilt="l2">Canada<br />live now</Stamp>
        <Stamp big="?" tilt="r2" style="background:#fff;color:var(--plum-soft);border-style:dotted;">up<br />next</Stamp>
      </div>
    </div>
  </section>

  <!-- SAY HI -->
  <section class="section bg-plum" id="say-hi">
    <div class="wrap" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;">
      <span class="eyebrow" style="color:var(--gold);">Don't be a stranger</span>
      <h2 class="script" style="color:#fff;font-size:clamp(40px,6vw,76px);line-height:.95;">Come say hi</h2>
      <p style="color:rgba(255,255,255,.88);max-width:44ch;font-weight:600;">Got a tip, a question, or a couch in a city I'm about to ruin? I read everything — even if I reply three time zones late.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:8px;">
        <a href="mailto:vito.zbw@gmail.com" class="btn btn--coral btn--lg"
          >Send a postcard
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a href="https://www.instagram.com/vito_baiwei/" target="_blank" rel="me noopener noreferrer" class="btn btn--gold btn--lg">Find me on Instagram</a>
      </div>
    </div>
  </section>
</Layout>
