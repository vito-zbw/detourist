# Sanity — the content source. Astro reads these at BUILD time.
#
# Leave SANITY_PROJECT_ID empty (or delete this file's values) to build the
# site against the bundled SEED content in src/lib/seed.ts. Set them to your
# Sanity project to build against live content instead. No code change needed —
# src/lib/content.ts switches sources automatically.

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Only required if your dataset is private. Public datasets need no token.
SANITY_API_READ_TOKEN=
